LLM_PROVIDER=stub
# claude-code: Claude через Claude Code CLI (подписка). Токен — `claude setup-token`; CLI в образ — WITH_CLAUDE_CODE=1
WITH_CLAUDE_CODE=0
# CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_MODEL=sonnet
CLAUDE_CODE_EFFORT=low
CLAUDE_CODE_TIMEOUT=120
LLM_FALLBACK=
OPENAI_LLM_MODEL=gpt-4o-mini
# GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL=true
LLM_TIMEOUT=30
LLM_MAX_TOKENS=512
PROMPT_VERSION=v2
RAG_TOP_K=5
RAG_MIN_SCORE=0.0
RAG_CONTEXT_TOKENS=3000
LOG_LEVEL=INFO
EMBEDDER=hashing
# OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=128
EMBEDDING_CACHE_SIZE=10000
VECTOR_STORE=qdrant
SEARCH_MODE=bm25
RRF_K=60
RERANKER=none
RERANK_CANDIDATES=20
CHUNK_SIZE=300
CHUNK_OVERLAP=45
ADMIN_API_KEY=change-me

POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag

API_PORT=8000
POSTGRES_PORT=5433
QDRANT_PORT=6334
STT=stub
# STT=faster-whisper + WITH_STT=1 — распознавание голосовых (только faster-whisper, без PyTorch)
WITH_STT=0
WHISPER_MODEL=base
WHISPER_CPU_THREADS=2
WHISPER_COMPUTE_TYPE=int8
VAD=energy
VAD_MIN_SILENCE_MS=600
TTS=stub
TTS_SPEAKER=xenia
TTS_SAMPLE_RATE=24000
VOICE_STREAMING=true

REDIS_PORT=6380
# TELEGRAM_TOKEN=
# TELEGRAM_SECRET=
# webhook — prod за HTTPS (нужен TELEGRAM_SECRET); polling — локально, без публичного адреса
TELEGRAM_MODE=webhook
TELEGRAM_WHITELIST=
# false — на голосовое бот отвечает только текстом (без TTS)
TELEGRAM_VOICE_REPLY=true

# Продакшен (docker-compose.prod.yml)
DOMAIN=rag.example.com
ACME_EMAIL=
WITH_LOCAL_MODELS=0
# лимит памяти api: локально по умолчанию 1536m, в prod 2560m
# API_MEMORY=2560m
