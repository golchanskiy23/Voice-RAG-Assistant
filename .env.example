# LLM
LLM_PROVIDER=openai          # openai | gigachat
LLM_FALLBACK=gigachat
OPENAI_API_KEY=
GIGACHAT_CREDENTIALS=

# Поиск
EMBEDDER=openai              # openai | e5 | bge-m3
VECTOR_STORE=qdrant          # qdrant | pgvector
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVE_TOP_N=20
TOP_K=5
RERANK_ENABLED=true
SCORE_THRESHOLD=0.3

# Голос
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
TTS_SPEAKER=xenia

# Хранилища
DATABASE_URL=postgresql+asyncpg://rag:rag@postgres:5432/rag
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379/0

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_SECRET=
TELEGRAM_WHITELIST=          # chat_id через запятую

# Служебное
ADMIN_API_KEY=
LOG_LEVEL=INFO
